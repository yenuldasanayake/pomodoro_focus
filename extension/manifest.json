{
  "manifest_version": 3,
  "name": "Pomodoro Focus Site Blocker",
  "version": "1.0.0",
  "description": "Blocks distracting sites while the Pomodoro Focus app has site blocking enabled.",
  "permissions": [
    "alarms",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Pomodoro Focus site blocking",
    "default_popup": "popup.html"
  }
}
